{
  "manifest_version": 3,
  "name": "Save Image as Type",
  "version": "1.0.4",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "activeTab"
  ]
,
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}